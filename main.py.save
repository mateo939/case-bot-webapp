import logging
import threading
import random
import sqlite3
import sys
from aiogram import Bot, Dispatcher, types, executor
from flask import Flask, jsonify, request
from flask_cors import CORS

# Импортируем твои данные из cases_data.py
import cases_data 

# --- КОНФИГУРАЦИЯ ---
API_TOKEN = '8683357071:AAGrfQ_qBVWOvHV0cymHgbueKIOjxM6jRmI'
ADMIN_ID = 1326919289
WEB_APP_URL = "https://mateo939.github.io/case-bot-webapp/"
DB_NAME = 'case_bot.db'

logging.basicConfig(level=logging.INFO)
app = Flask("stars_app") 
CORS(app)


bot = Bot(token=API_TOKEN)
dp = Dispatcher(bot)

# --- БАЗА ДАННЫХ ---
def init_db():
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    # Баланс по умолчанию 0, как ты и просил
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS users (
            user_id INTEGER PRIMARY KEY,
            balance INTEGER DEFAULT 0
        )
    ''')
    conn.commit()
    conn.close()

def get_balance(user_id):
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute('SELECT balance FROM users WHERE user_id = ?', (user_id,))
    res = cursor.fetchone()
    if res is None:
        cursor.execute('INSERT INTO users (user_id, balance) VALUES (?, ?)', (user_id, 0))
        conn.commit()
        balance = 0
    else:
        balance = res[0]
    conn.close()
    return balance

def update_balance(user_id, amount):
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute('UPDATE users SET balance = balance + ? WHERE user_id = ?', (amount, user_id))
    conn.commit()
    conn.close()

# --- ЛОГИКА БОТА ---
@dp.message_handler(commands=['start'])
async def start_cmd(message: types.Message):
    user_id = message.from_user.id
    balance = get_balance(user_id)
    kb = types.InlineKeyboardMarkup()
    kb.add(types.InlineKeyboardButton(text="✨ Открыть Звезды", web_app=types.WebAppInfo(url=WEB_APP_URL)))
    await message.answer(f"Привет, {message.from_user.first_name}!\nТвой баланс: {balance} звезд.", reply_markup=kb)

# Команда для тебя, чтобы выдать себе звезды для теста
@dp.message_handler(commands=['give'])
async def give_cmd(message: types.Message):
    if message.from_user.id == ADMIN_ID:
        args = message.get_args()
        if args.isdigit():
            update_balance(ADMIN_ID, int(args))
            await message.answer(f"✅ Начислено {args} звезд!")

# --- API ДЛЯ ИГРЫ (GITHUB PAGES) ---
@app.route('/api/get_balance', methods=['GET'])
def api_balance():
    uid = request.args.get('user_id')
    if not uid: return jsonify({"error": "No ID"}), 400
    return jsonify({"balance": get_balance(uid), "status": "ok"})

@app.route('/api/open_case', methods=['POST'])
def api_open_case():
    data = request.json
    uid = data.get('user_id')
    case_id = data.get('case_id') # Например, 1 или 2
    
    # Ищем кейс в твоих данных
    current_case = next((c for c in cases_data.cases if c['id'] == case_id), None)
    if not current_case:
        return jsonify({"error": "Case not found"}), 404
    
    balance = get_balance(uid)
    if balance < current_case['price']:
        return jsonify({"error": "Not enough stars"}), 400
    
    # Списываем цену кейса
    update_balance(uid, -current_case['price'])
    
    # Логика выпадения предмета по шансам из cases_data.py
    items = cases_data.case_items.get(case_id, [])
    win = random.choices(items, weights=[i['chance'] for i in items], k=1)[0]
    
    # Начисляем ценность (value) выигранного предмета обратно на баланс (или в инвентарь)
    update_balance(uid, win['value'])
    
    return jsonify({
        "item": win['name'],
        "new_balance": get_balance(uid),
        "status": "success"
    })

# --- ЗАПУСК ---
def main():
    init_db()
    threading.Thread(target=lambda: app.run(host='0.0.0.0', port=5000), daemon=True).start()
    executor.start_polling(dp, skip_updates=True)

if __name__ == '__main__':
    main()
